<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- oMLX 서버. brew services 의 homebrew.mxcl.omlx(KeepAlive/RunAtLoad true) 대신 쓴다.
       자동 시작·자동 재시작은 끈다(check-autostart). 기동: launchctl kickstart -k gui/$UID/com.local-llm.omlx,
       중지: launchctl kill TERM gui/$UID/com.local-llm.omlx. 설정(포트·메모리 티어·캐시)은 ~/.omlx/settings.json 이 진실. -->
  <key>Label</key><string>com.local-llm.omlx</string>
  <key>ProgramArguments</key>
  <array>
    <string>__OMLX_BIN__</string>
    <string>serve</string>
  </array>
  <key>RunAtLoad</key><false/>
  <key>KeepAlive</key><false/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/omlx/omlx.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/omlx/omlx.log</string>
</dict>
</plist>
