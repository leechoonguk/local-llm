# qwen3.6-coder — Qwen3.6-35B-A3B (MoE, 3B active) NVFP4, tuned for coding agents
# Qwen official "precise coding" sampling (thinking mode): temp 0.6 / top_p 0.95 / top_k 20 / presence 0
# Create: ollama create qwen3.6-coder -f ollama/Modelfile.qwen3.6-coder
FROM qwen3.6:35b-a3b-nvfp4

PARAMETER num_ctx 65536
PARAMETER num_predict 32768
PARAMETER temperature 0.6
PARAMETER top_p 0.95
PARAMETER top_k 20
PARAMETER min_p 0
PARAMETER presence_penalty 0
PARAMETER repeat_penalty 1
