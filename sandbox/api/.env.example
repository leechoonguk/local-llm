# =============================================================================
# API request environment — read by api/*.http through {{$dotenv API_BASE_URL}}.
# REST Client resolves $dotenv from the .env sitting next to the .http file, so
# this pair lives in api/, not at the repository root.
# Copy to api/.env and point it at the server you are calling.
# Keep this file in sync with .env (same keys, same sections).
# =============================================================================

# --- Target ---
# Origin every api/*.http resolves {{base}} from — scheme://host:18000, no path.
# The /api/v1 prefix stays in the request files (and /health sits above it, which
# is why this value is an origin and not a base).
# The port is always 18000; the host is whatever serves the API to you (localhost
# for `cd backend && make dev`, a LAN or public address for a remote run).
API_ORIGIN = http://localhost:18000
