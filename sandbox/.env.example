# =============================================================================
# Docker Compose environment — copy to .env and adjust as needed.
# Docker Compose reads .env in the project root automatically.
# Service ports are fixed in docker-compose.yml (15432/16379/16006/14317/18000/15173).
# =============================================================================

# --- PostgreSQL ---
# DB credentials used by docker-compose services
POSTGRES_USER = app
POSTGRES_PASSWORD = app
POSTGRES_DB = app

# --- Environment ---
# Runtime environment: local | production (root=production container, backend=local dev — intentional)
ENV = production

# --- Backend URLs (passed to the backend container by docker-compose.yml) ---
# Async PostgreSQL connection string
DATABASE_URL = postgresql+asyncpg://app:app@postgres:5432/app
# Redis cache connection
REDIS_URL = redis://redis:6379/0

# --- Phoenix (LLM observability) ---
# Phoenix SQL schema name
PHOENIX_SQL_DATABASE_SCHEMA = phoenix

# --- External API Integration ---
# Defaults for outbound HTTP calls (see backend-integration.md)
INTEGRATION_TIMEOUT_SECONDS = 30.0
INTEGRATION_CONNECT_TIMEOUT_SECONDS = 5.0
INTEGRATION_MAX_RETRIES = 3
INTEGRATION_RETRY_BASE_SECONDS = 0.5
INTEGRATION_RETRY_MAX_SECONDS = 8.0

# --- Backend (FastAPI) ---
# Application display name (shared — docker-compose passes root value to backend container)
APP_NAME = "Awesome API"
# Allowed browser origins (Pydantic parses this JSON list)
CORS_ORIGINS = ["http://localhost:15173"]
# Host header allowlist (TrustedHostMiddleware) — required, no default: an
# allowlist that accepts anything is the vulnerability it closes ("testserver" is
# the Host Starlette's TestClient sends)
ALLOWED_HOSTS = ["localhost", "127.0.0.1", "testserver", "112.151.225.121"]
# Admin contact email
ADMIN_EMAIL = admin@example.com
# Default items limit per user
ITEMS_PER_USER = 50
# JWT signing key — change in production
SECRET_KEY = change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES = 30
ALGORITHM = HS256
